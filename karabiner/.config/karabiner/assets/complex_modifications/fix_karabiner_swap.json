{
  "title": "Fix Swedish keyboard § and < swap that occured during Karabiner install",
  "rules": [
    {
      "description": "Fix Swedish keyboard § and < swap",
      "manipulators": [
        {
          "description": "Swap unshifted: < ↔ §",
          "type": "basic",
          "from": {
            "key_code": "grave_accent_and_tilde"
          },
          "to": [
            {
              "key_code": "non_us_backslash"
            }
          ]
        },
        {
          "description": "Swap unshifted: § ↔ <",
          "type": "basic",
          "from": {
            "key_code": "non_us_backslash"
          },
          "to": [
            {
              "key_code": "grave_accent_and_tilde"
            }
          ]
        },
        {
          "description": "Swap shifted: > ↔ ½",
          "type": "basic",
          "from": {
            "key_code": "grave_accent_and_tilde",
            "modifiers": {
              "mandatory": ["shift"]
            }
          },
          "to": [
            {
              "key_code": "non_us_backslash",
              "modifiers": ["shift"]
            }
          ]
        },
        {
          "description": "Swap shifted: ½ ↔ >",
          "type": "basic",
          "from": {
            "key_code": "non_us_backslash",
            "modifiers": {
              "mandatory": ["shift"]
            }
          },
          "to": [
            {
              "key_code": "grave_accent_and_tilde",
              "modifiers": ["shift"]
            }
          ]
        }
      ]
    }
  ]
}